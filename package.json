{
  "name": "markdown-viewer-v2-reset",
  "version": "0.1.0",
  "description": "Markdown Viewer v2 重置版桌面应用骨架",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -b tsconfig.app.json tsconfig.electron.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.electron.json"
  },
  "dependencies": {
    "dompurify": "^3.2.3",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.1.0",
    "electron": "^42.4.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
