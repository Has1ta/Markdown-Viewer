{
  "name": "markdown-viewer-v2-reset",
  "version": "0.1.0",
  "description": "Markdown Viewer v2 重置版桌面应用骨架",
  "author": "Has1ta",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "build": "tsc -b tsconfig.app.json tsconfig.electron.json && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --win && npm run release:helpers",
    "release:helpers": "node scripts/write-release-uninstaller.cjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.electron.json"
  },
  "build": {
    "appId": "com.has1ta.markdownviewer",
    "productName": "Markdown Viewer",
    "icon": "public/app-icon.ico",
    "asar": true,
    "compression": "maximum",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd"
          ],
          "name": "Markdown Document",
          "description": "Markdown 文档"
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "^7.21.2",
    "@milkdown/utils": "^7.21.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "dompurify": "^3.4.11",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.5.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.0.5",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.1"
  }
}
